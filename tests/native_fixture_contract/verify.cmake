string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(root "${OUTPUT}/żółte dane ${id}")
file(MAKE_DIRECTORY "${root}")
execute_process(COMMAND "${TOOL}" "${root}" RESULT_VARIABLE result)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Fixture generation failed: ${root}")
endif()
function(check_hash name expected)
    file(SHA256 "${root}/${name}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Fixture bytes changed: ${name}: ${actual}")
    endif()
endfunction()
# Golden bytes independently reconstructed from the original fixture layout:
# little-endian RMESH v1, 1024 three-vertex meshes, fixed material and index.
check_hash(car.rmesh c059bebfd5bbcd7292a2bc9e374fc139fea96ebea6a8a4d41619ee15a5d62a9c)
check_hash(runtime-index.txt f67e71ec4f28d517823c27b3f8a0eff8064829f094bac24de3c4e8ae253c5c67)
check_hash(material.rgba 3b874d3ba46c638fc3094f8e92fb744ca974893873f8885f54e23760f9b6311b)
check_hash(material.rpaint 916b144867c340614f515c7b0e5415c74832d899c05264ded2a277a6e81d81ff)
check_hash(material.rmat b57871494c3e9fa1fdf008b7e5160e6092cb546ca5a1648bb1771d330bfe3af0)
file(SIZE "${root}/car.rmesh" size)
if(NOT size EQUAL 139292)
    message(FATAL_ERROR "Wrong mesh size: ${size}")
endif()
file(SIZE "${root}/material.rgba" size)
if(NOT size EQUAL 262144)
    message(FATAL_ERROR "Wrong RGBA size")
endif()
file(SIZE "${root}/material.rpaint" size)
if(NOT size EQUAL 65536)
    message(FATAL_ERROR "Wrong paint size")
endif()
file(READ "${root}/terrain.png" signature LIMIT 24 HEX)
if(NOT signature STREQUAL "89504e470d0a1a0a0000000d494844520000004000000020")
    message(FATAL_ERROR "Wrong PNG signature or dimensions: ${signature}")
endif()
file(SHA256 "${root}/car.rmesh" before)
execute_process(COMMAND "${TOOL}" "${root}" RESULT_VARIABLE result)
file(SHA256 "${root}/car.rmesh" after)
if(result STREQUAL "0" OR NOT before STREQUAL after)
    message(FATAL_ERROR "Existing fixture was overwritten")
endif()
