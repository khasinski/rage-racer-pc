if(NOT DEFINED GAME OR NOT DEFINED SOURCE)
    message(FATAL_ERROR "GAME and SOURCE are required")
endif()
set(disc "$ENV{RAGE_PORT_DISC_IMAGE}")
if(disc STREQUAL "")
    set(disc "$ENV{RAGE_PORT_DISC_CUE}")
endif()
if(disc STREQUAL "")
    set(disc "${SOURCE}/disc/PAL/Rage Racer (Europe)/Rage Racer (Europe).cue")
endif()
if(NOT EXISTS "${disc}" OR IS_DIRECTORY "${disc}")
    message("SKIP: no disc image for Grand Prix results")
    return()
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_AUDIODRIVER=dummy
    RAGE_PORT_SMOKE_FRAMES=3500 RAGE_PORT_SMOKE_FINISH_FRAME=2000
    RAGE_PORT_SMOKE_AUTO_CONFIRM_FRAME=3000
    RAGE_PORT_INPUT_SCRIPT=400:START,500:START,650:CROSS,950:CROSS,1100:CROSS,1200:CROSS,1700-2400:CROSS
    "${GAME}" --set "disc.image=${disc}" WORKING_DIRECTORY "${SOURCE}" TIMEOUT 210
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
set(log "${output}${error}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Grand Prix result route failed (${result}):\n${log}")
endif()
foreach(transition "scene=17 frontend=3" "scene=18 frontend=3" "scene=19 frontend=3")
    string(FIND "${log}" "${transition}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Grand Prix missed result transition ${transition}")
    endif()
endforeach()
string(FIND "${log}" "scene=17 frontend=3" replay_position)
string(SUBSTRING "${log}" 0 ${replay_position} before_replay)
string(LENGTH "${log}" log_length)
string(SUBSTRING "${log}" ${replay_position} ${log_length} replay_and_after)
string(REGEX MATCHALL "opened (track .*\\(Track [0-9]+\\)\\.bin|virtual track [0-9]+)" before_tracks "${before_replay}")
string(REGEX MATCHALL "opened (track .*\\(Track [0-9]+\\)\\.bin|virtual track [0-9]+)" replay_tracks "${replay_and_after}")
if(NOT before_tracks OR NOT replay_tracks)
    message(FATAL_ERROR "Grand Prix did not report CD-DA track switches")
endif()
list(GET before_tracks -1 last_before)
list(GET replay_tracks 0 first_replay)
string(REGEX MATCH "[0-9]+" last_before_number "${last_before}")
set(last_before_track "${CMAKE_MATCH_0}")
string(REGEX MATCH "[0-9]+" first_replay_number "${first_replay}")
set(first_replay_track "${CMAKE_MATCH_0}")
if(last_before_track LESS_EQUAL 2 OR NOT first_replay_track EQUAL 12)
    message(FATAL_ERROR "Race CD-DA did not switch to replay track: before=${last_before_track}, replay=${first_replay_track}")
endif()
if(NOT log MATCHES "stopped at frame 3500, scene (8|10|11|12),")
    message(FATAL_ERROR "Grand Prix did not advance from results to next round")
endif()
foreach(failure "primitive buffer exhausted" "ERROR: AddressSanitizer")
    string(FIND "${log}" "${failure}" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "Grand Prix result path reported ${failure}")
    endif()
endforeach()
message(STATUS "Grand Prix reached results, awarded prize money, and started next round")
