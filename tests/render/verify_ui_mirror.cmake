string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(root "${OUTPUT_ROOT}/ui-mirror-${id}")
file(MAKE_DIRECTORY "${root}/mods")
execute_process(COMMAND "${FIXTURE}" write "${root}/mods/crest.png" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Cannot create mirror fixture")
endif()
file(WRITE "${root}/mods/mod.toml" "[textures]\n\"ui.scene.4.page.153.clut.32256.region.0.0.108.136\" = \"crest.png\"\n")
file(WRITE "${root}/game.ini" "[modern]\nassets = disc\n[video]\nrenderer = modern\ninternal_scale = 4\naspect = 4:3\nfps = logic\npost = none\ngrading = off\nbrightness = 0.8695652174\n[mods]\ndirectory = ${root}/mods\n[run]\nframes = 395\n[diagnostics]\nmodern_dump = ${root}/ui.ppm\nmodern_dump_frame = 380\nmodern_dump_offscreen = true\nui_trace = true\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_AUDIODRIVER=dummy RAGE_PORT_DISABLE_HOST_INPUT=1 "${GAME}" --config "${root}/game.ini" WORKING_DIRECTORY "${SOURCE}" TIMEOUT 60 RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Mirror capture failed: ${root}\n${output}${error}")
endif()
execute_process(COMMAND "${FIXTURE}" check "${root}/ui.ppm" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Reflected region failed: ${root}\n${output}${error}")
endif()
