string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
set(root "${OUTPUT_ROOT}/menu-preview-${id}")
file(MAKE_DIRECTORY "${root}/mods")
execute_process(COMMAND "${FIXTURE}" write-atlas "${root}/mods/atlas.png" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot create menu atlas fixture")
endif()
# Any scene-8 HD atlas activates native UI replay. The course model must still
# be present in that stream; it has no replacement in the semantic race world.
file(WRITE "${root}/mods/mod.toml" "[textures]\n\"ui.scene.8.page.25.clut.32577\" = \"atlas.png\"\n")
file(WRITE "${root}/game.ini" "[modern]\nassets = disc\n[video]\nrenderer = modern\ninternal_scale = 2\naspect = 16:9\nfps = logic\n[mods]\ndirectory = ${root}/mods\n[input]\ndisable_host = true\nstate_script = 5@90:START,4@40:DOWN,4@44:CONFIRM\nraw_script = 586-590:RIGHT,726-730:RIGHT\n[run]\nframes = 1100\n[stop]\nscene = 8\ntimer = 450\n[diagnostics]\nscene_trace = ${root}/capture.log\nmodern_dump = ${root}/preview.ppm\nmodern_dump_scene_id = 8\nmodern_dump_timer = 420\nmodern_dump_offscreen = true\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env PSYZ_HEADLESS=1 SDL_AUDIODRIVER=dummy
    SDL_MAC_BACKGROUND_APP=1 "${GAME}" --config "${root}/game.ini"
    WORKING_DIRECTORY "${SOURCE}" TIMEOUT 55 RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT EXISTS "${root}/preview.ppm")
    message(FATAL_ERROR "Time Attack preview failed: ${root}\n${output}${error}")
endif()
file(STRINGS "${root}/capture.log" frames REGEX "scene=8 timer=[234][0-9][0-9] ")
list(LENGTH frames count)
if(count LESS 100)
    message(FATAL_ERROR "Too few course preview frames: ${root}")
endif()
set(visible 0)
foreach(frame IN LISTS frames)
    if(NOT frame MATCHES "skipped3d=0 overflow=0,0,0,0,0")
        message(FATAL_ERROR "Course geometry missing from UI capture: ${frame}\n${root}")
    endif()
    if(frame MATCHES "faces=[1-9][0-9]* skipped3d=0")
        math(EXPR visible "${visible} + 1")
    endif()
endforeach()
if(visible LESS 100)
    message(FATAL_ERROR "Course previews did not return after browsing: ${root}")
endif()
