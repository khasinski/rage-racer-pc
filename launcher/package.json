{
  "name": "rage-racer-launcher",
  "productName": "Rage Racer Editor",
  "version": "0.1.0",
  "private": true,
  "description": "Unified game manager and asset editor for Rage Racer PC",
  "main": "main/index.cjs",
  "scripts": {
    "start": "node scripts/start.cjs",
    "start:car": "node scripts/start.cjs --studio=car",
    "start:track": "node scripts/start.cjs --studio=track",
    "mcp": "node scripts/mcp-server.cjs",
    "build:native": "node scripts/build-native.cjs",
    "package": "node scripts/package.cjs",
    "test": "node scripts/test-native.cjs && node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "@electron/packager": "20.3.0"
  }
}
