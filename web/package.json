{
  "name": "rage-racer-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser experiment: Rage Racer running the native C simulation and scene pipeline as WebAssembly, drawn with three.js.",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
