#include <winver.h>
/* Generated by CMake from rage-racer-version.h.in. */
#include "rage-racer-version.h"

1 ICON "RageRacer.ico"

/* Complete version metadata identifies the executable to Windows Explorer,
 * SmartScreen and anti-malware heuristics; an anonymous binary is more likely
 * to be classified as suspicious. */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION RAGE_RC_VERSION_MAJOR,RAGE_RC_VERSION_MINOR,RAGE_RC_VERSION_PATCH,0
 PRODUCTVERSION RAGE_RC_VERSION_MAJOR,RAGE_RC_VERSION_MINOR,RAGE_RC_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Rage Racer PC project"
            VALUE "FileDescription", "Rage Racer PC"
            VALUE "FileVersion", RAGE_RC_VERSION_STRING
            VALUE "InternalName", "rage-racer"
            VALUE "LegalCopyright", "Rage Racer PC contributors. Rage Racer is a trademark of Bandai Namco."
            VALUE "OriginalFilename", "Rage-Racer.exe"
            VALUE "ProductName", "Rage Racer PC"
            VALUE "ProductVersion", RAGE_RC_VERSION_STRING
            VALUE "Comments", "Native PC port. Requires a legally obtained Rage Racer disc image."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
