.venv/
build/
build-*/
disc/**
!disc/.gitkeep
!disc/PAL/
!disc/PAL/.gitkeep
!disc/USA/
!disc/USA/.gitkeep
disc/*.bin
disc/*.cue
disc/*.7z
disc/*.xml
assets/**/*.exe
assets/**/SYSTEM.CNF
*.pyc
__pycache__/
.DS_Store
.idea/
.vscode/
*.o
*.a
*.elf
*.map
*.mcd

# Generated split output.
asm/**
!asm/
!asm/.gitkeep
!asm/PAL/
!asm/PAL/.gitkeep
!asm/PAL/main/
!asm/PAL/main/.gitkeep
!asm/USA/
!asm/USA/.gitkeep
!asm/USA/main/
!asm/USA/main/.gitkeep
linkers/**/*.ld
linkers/**/undefined_*.txt
linkers/**/addr_halves.*.txt
!linkers/**/undefined_syms_manual.txt

# Local reverse-engineering scratch/output.
scratch/
proposals/
prompts/
tmp/
nonmatchings/
reference/
local/
expected/
extracted/
extracted_assets/

# Local toolchains and external helper clones. The build may populate
# build/toolchain/, but source releases must not publish these.
/sdk/
tools/asm-differ
tools/decomp-permuter/
tools/m2c/
tools/maspsx/
tools/maspsx_*/
tools/wibo/
tools/mkpsxiso-bin/
tools/psyq-gcc-*/
tools/psx-ruby/
local.mk

# Retail game data is required locally but cannot be distributed with the
# source port.
assets/*/RAGE.BIN
assets/*/fmv/

# Generated reports.
tools/asm_report.html
tools/asset_map.html
tools/source_browser.html
build/**/report.json

# Internal agent briefs, their reports, and the decompilation guide: kept
# locally, not published. These describe how a particular session was run and
# mean nothing to someone cloning the repository; durable findings belong in
# docs/names.md instead.
docs/TASK_FOR_*.md
docs/*_REPORT.md
docs/*_REPORT_*.md
# Per-function agent notes: durable findings belong in docs/names.md instead.
docs/func_*.md
docs/DECOMPILATION_GUIDE.md

# Debug dump written by decomp-permuter when a compile fails.
debug_source.c

# Compiler dumps (cc1 -dl/-dg) and cpp -MD dependency files. cc.sh feeds the
# source on stdin, so cc1 names its dumps after "-".
*.lreg
*.greg
*.d
-.*

# Scratch work from decompilation sessions.
tools/decomp-wip/

# Local emulator/native visual checkpoints and replay artifacts. Durable
# conclusions and reproduction commands belong in PORT_BRIEF.md.
.visual-cache/
